load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test", "rust_binary")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# Core Rust library with google/zerocopy
rust_library(
    name = "chazelle",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "@crates//:rayon",
        "@crates//:zerocopy",
    ],
)

# Rust static library for C/C++ FFI
rust_static_library(
    name = "chazelle_ffi",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = [
        "@crates//:rayon",
        "@crates//:zerocopy",
    ],
)

# Rust integration tests
rust_test(
    name = "integration_test",
    srcs = ["tests/integration_tests.rs"],
    edition = "2024",
    deps = [
        ":chazelle",
        "@crates//:zerocopy",
    ],
)

# C / C++ header library
cc_library(
    name = "chazelle_cc",
    hdrs = [
        "include/chazelle.h",
        "include/chazelle.hpp",
    ],
    includes = ["include"],
    deps = [":chazelle_ffi"],
)

# C binding test
cc_test(
    name = "c_test",
    srcs = ["tests/c_test.c"],
    deps = [":chazelle_cc"],
)

# C++ binding test
cc_test(
    name = "cpp_test",
    srcs = ["tests/cpp_test.cpp"],
    deps = [":chazelle_cc"],
)

# Benchmark binary producing Bencher Metric Format (BMF) JSON
rust_binary(
    name = "bench_triangulation",
    srcs = ["benches/bench_triangulation.rs"],
    edition = "2024",
    deps = [
        ":chazelle",
        "@crates//:rayon",
        "@crates//:zerocopy",
    ],
)
